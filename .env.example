# ------------------------------------------------------------------------------
# Configurações de Ambiente para o n8n e Ngrok
# Copie este arquivo para um arquivo chamado `.env` no mesmo diretório e configure.
# ------------------------------------------------------------------------------

# Token de autenticação entre o n8n e o n8n-runner
# Pode ser gerado com um comando do tipo: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=seu_token_gerado_aqui

# API Key do OpenWeather para consulta de clima
OPENWEATHER_API_KEY=sua_chave_openweather_aqui

# URL do Webhook do n8n (gerada pelo Ngrok)
# Deve ser idêntica a: https://<seu-subdominio-ngrok>.ngrok-free.dev
WEBHOOK_URL=https://seu-subdominio-ngrok.ngrok-free.dev

# Token de autenticação do Ngrok (obtido no painel do Ngrok)
NGROK_AUTHTOKEN=seu_ngrok_authtoken_aqui

# Domínio estático reservado no Ngrok
# Exemplo: seu-subdominio-ngrok.ngrok-free.dev
NGROK_DOMAIN=seu-subdominio-ngrok.ngrok-free.dev
